DATABASE_URL="postgresql://sinclairs:sinclairs_dev@localhost:5432/sinclairs_hotels"

# sinclairshotels.com still serves the old WordPress site (see lib/site-url.ts),
# so absolute URLs built for emails (logo image, voucher view links) must point
# here instead, or they 404 against the wrong site. Remove once the real domain
# cuts over to this app.
SITE_BASE_URL=https://sinclairs-hotels.vercel.app

RESEND_API_KEY=
# Custom "from" address once sinclairshotels.com is verified at
# https://resend.com/domains. Until then, lib/mail.ts falls back to Resend's
# onboarding@resend.dev sender, which needs no verification.
MAIL_FROM_ADDRESS=
# Where staff-facing notifications (enquiry, newsletter signup, voucher office copy,
# daily digest) go. Also who every outbound email is Bcc'd to, if set.
STAFF_NOTIFY_EMAIL=

# Booking office that receives a copy of every voucher. Defaults to
# kolkata@sinclairshotels.com in lib/mail.ts, so this only needs setting to
# override it. Not the same as the public reservations@ address guests write to.
VOUCHER_OFFICE_EMAIL=
OWNER_BCC_EMAIL=
# Pre-launch safety valve: when set, every outbound email (voucher guest/office
# copies, enquiry notifications, i-Pay confirmations) is redirected here instead
# of the real guest/hotel address, with the original recipient kept in the
# subject line. Unset once real guests/hotels should actually receive mail.
MAIL_RECIPIENT_OVERRIDE=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# Authenticates the daily digest cron endpoint — Vercel sends this same value as
# the Authorization: Bearer header when it calls scheduled routes.
CRON_SECRET=
# Who the daily digest email goes to (legacy: Ravi's Gmail, with admin@ Bcc).
DIGEST_TO_EMAIL=
DIGEST_BCC_EMAIL=

# i-Pay: ICICI Bank Payment Gateway (Standard/redirect mode — card data is
# captured on ICICI's own domain, never on this app, keeping it at PCI-DSS
# SAQ-A). Merchant ID, aggregator ID, and HMAC key come from ICICI's merchant
# onboarding, never committed. ICICI_ENV selects pgpayuat.icici.bank.in
# ("uat", the default) vs pgpay.icici.bank.in ("production").
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_HMAC_KEY=
ICICI_ENV=uat

# Set to "on" in an environment where a hotel page has been opened and the Google
# Maps embed was seen to render. Anywhere else the map box shows the address and
# an "Open in Google Maps" link instead — a frame that cannot load leaves a grey
# rectangle, and no script can detect that to recover from it. Inlined at build
# time, so changing it needs that environment rebuilt.
NEXT_PUBLIC_MAPS_EMBED=

# GTM container ID (GTM-XXXXXXX) from the Ads/Analytics account. GA4 itself is
# configured as a tag inside that GTM container, not here. Unset in dev/preview
# until the container exists — app/layout.tsx skips rendering GTM when empty.
NEXT_PUBLIC_GTM_ID=

# GA4 measurement ID (G-XXXXXXXXXX). Set this only while the GTM container has
# no tags forwarding our nine events — it makes lib/analytics.ts send them to
# GA4 directly, in parallel with the dataLayer pushes GTM reads. Once the
# next-site-cutover workspace is published in GTM, unset this or every event is
# counted twice. See docs/analytics-events.md § Transport.
NEXT_PUBLIC_GA4_ID=

# Vercel Blob, where photos replaced from /admin/photos are stored. Uploads
# refuse without it; "Choose from library" still works, since it stores a path
# and no bytes. Vercel sets this automatically once a Blob store is attached to
# the project.
BLOB_READ_WRITE_TOKEN=
