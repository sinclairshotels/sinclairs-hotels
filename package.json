{
  "name": "sinclairs-hotels",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && tsx scripts/sync-room-types.ts && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci-local": "CI=true vitest run",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "verify:ci": "pnpm prisma:migrate:deploy && pnpm sync:rooms && pnpm check:images && pnpm lint && pnpm typecheck && pnpm test:ci-local && pnpm build",
    "postinstall": "prisma generate",
    "check:images": "node scripts/check-image-budget.mjs",
    "prune:deployments": "vercel remove sinclairs-hotels --safe --yes",
    "seed:dev": "tsx prisma/seed-dev.ts",
    "sync:rooms": "tsx scripts/sync-room-types.ts",
    "photos:prune": "tsx scripts/prune-photos.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.4",
    "@prisma/client": "^6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "sharp": "^0.35.4",
    "zod": "^3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2"
  },
  "packageManager": "pnpm@9.15.9"
}
